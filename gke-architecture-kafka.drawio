        <mxCell id="psc" parent="1" style="fillColor=#DAE8FC;strokeColor=#6C8EBF;rounded=1;fontSize=11;html=1;whiteSpace=wrap;" value="Private Service Connect endpoints in dev-subnet&lt;br&gt;bootstrap.job-manager-kafka.us-central1.managedkafka.&lt;br&gt;k8s-dev-412419.cloud.goog:9092 · SASL_SSL · OAUTHBEARER (Workload Identity)" vertex="1"><mxGeometry x="1235" y="315" width="395" height="60" as="geometry"/></mxCell>
        <mxCell id="topics" parent="1" style="fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;rounded=1;fontSize=11;html=1;whiteSpace=wrap;" value="&lt;b&gt;Topics&lt;/b&gt; (key = job id)&lt;br&gt;jobs-demo-echo · 6 partitions · 1 day&lt;br&gt;jobs-demo-sleep · 6 · 1 day&lt;br&gt;jobs-report-generate · 6 · 1 day&lt;br&gt;jobs-email-send · 6 · 1 day&lt;br&gt;jobs-retry · 6 · 1 day&lt;br&gt;jobs-dlq · 3 · 7 days&lt;br&gt;&lt;span style='color:#666666'&gt;one topic per job type: a slow type never blocks another · 6 partitions = HPA max&lt;/span&gt;" vertex="1"><mxGeometry x="1235" y="385" width="395" height="175" as="geometry"/></mxCell>
        <mxCell id="sql" parent="1" style="fillColor=#D5E8D4;strokeColor=#B85450;strokeWidth=2;rounded=1;fontSize=11;html=1;whiteSpace=wrap;" value="Cloud SQL Postgres 16 · messagedb-* · &lt;b&gt;source of truth&lt;/b&gt;&lt;br&gt;job_types · jobs (state, version, idempotency_key) · job_events · &lt;b&gt;outbox&lt;/b&gt; (planned)&lt;br&gt;ZONAL us-central1-a · private IP (PSA 10.16.0.0/20) · TLS · no backups" vertex="1"><mxGeometry x="1220" y="600" width="425" height="115" as="geometry"/></mxCell>
        <mxCell id="sqlnote" parent="1" style="text;fontSize=10;align=left;verticalAlign=top;html=1;whiteSpace=wrap;" value="&lt;b&gt;Why both:&lt;/b&gt; Kafka dispatches work; Cloud SQL answers GetJob / ListJobs / CancelJob / ListJobEvents and dedups.&lt;br&gt;• at-least-once delivery → the worker moves QUEUED→RUNNING with a version check; duplicates and cancelled jobs are skipped&lt;br&gt;• run_after: the relay publishes only due rows · retries: delayed-retry-topic → DLQ after max_attempts&lt;br&gt;• ClaimJob / Heartbeat / LeaseReaper → consumer-group redelivery" vertex="1"><mxGeometry x="1220" y="722" width="425" height="125" as="geometry"/></mxCell>
        <mxCell id="sm" parent="1" style="fillColor=#DAE8FC;strokeColor=#6C8EBF;rounded=1;fontSize=11;html=1;whiteSpace=wrap;" value="Secret Manager&lt;br&gt;postgres-app-password · grafana-* · openobserve-*&lt;br&gt;(seeded from 1Password by op run)" vertex="1"><mxGeometry x="270" y="880" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="ar" parent="1" style="fillColor=#DAE8FC;strokeColor=#6C8EBF;rounded=1;fontSize=11;html=1;whiteSpace=wrap;" value="Artifact Registry springboot-grpc-o2&lt;br&gt;job-manager-api images (GitHub Actions, WIF)" vertex="1"><mxGeometry x="545" y="880" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="iam" parent="1" style="fillColor=#DAE8FC;strokeColor=#6C8EBF;rounded=1;fontSize=11;html=1;whiteSpace=wrap;" value="GSAs (gke-deploy.sh): gke-dev-nodes · crossplane-gcp · &lt;b&gt;crossplane-kafka&lt;/b&gt; · external-secrets · argocd-image-updater · ci-springboot-grpc-o2" vertex="1"><mxGeometry x="820" y="880" width="400" height="60" as="geometry"/></mxCell>
