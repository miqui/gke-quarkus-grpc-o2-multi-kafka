        <mxCell id="flow" parent="1" style="text;fontSize=10;align=left;verticalAlign=top;html=1;whiteSpace=wrap;" value="&lt;b&gt;Flow&lt;/b&gt;&lt;br&gt;① client → LB, TLS :443&lt;br&gt;② LB → an API replica, h2c (one NEG per zone)&lt;br&gt;③ CreateJob: job + outbox row, one Cloud SQL tx&lt;br&gt;④ relay produces to the job type's topic &lt;i&gt;(planned)&lt;/i&gt;&lt;br&gt;⑤ worker consumes, group job-workers &lt;i&gt;(planned)&lt;/i&gt;&lt;br&gt;⑥ worker records RUNNING / SUCCEEDED / FAILED &lt;i&gt;(planned)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#1F4E9E'&gt;blue&lt;/font&gt; request · &lt;font color='#2D7600'&gt;green&lt;/font&gt; SQL · &lt;font color='#9C6500'&gt;orange&lt;/font&gt; Kafka · dashed = planned · &lt;font color='#7A5A8C'&gt;purple dashed&lt;/font&gt; Crossplane manages" vertex="1"><mxGeometry x="20" y="775" width="205" height="230" as="geometry"/></mxCell>
