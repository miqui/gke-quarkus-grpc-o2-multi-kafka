        <mxCell id="pvtf" parent="1" style="fillColor=#E1D5E7;strokeColor=#9673A6;rounded=1;fontSize=11;html=1;whiteSpace=wrap;" value="&lt;b&gt;provider-opentofu v1.1.10&lt;/b&gt; → Managed Kafka&lt;br&gt;Workspace (inline HCL, google ~&gt; 8.7)&lt;br&gt;KSA provider-opentofu → GSA crossplane-kafka&lt;br&gt;(managedkafka.admin) · --timeout=60m" vertex="1"><mxGeometry x="810" y="645" width="268" height="80" as="geometry"/></mxCell>
