        <mxCell id="tfstate" parent="1" style="fillColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;rounded=1;fontSize=11;html=1;whiteSpace=wrap;" value="OpenTofu state: Secret&lt;br&gt;tfstate-default-job-manager-kafka-kafka&lt;br&gt;&lt;b&gt;lives only in this cluster&lt;/b&gt; → teardown deletes the KafkaCluster first" vertex="1"><mxGeometry x="810" y="740" width="268" height="65" as="geometry"/></mxCell>
        <mxCell id="mk" parent="1" style="fillColor=#FFF8EE;strokeColor=#D79B00;strokeWidth=2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=11;html=1;whiteSpace=wrap;" value="Managed Service for Apache Kafka · job-manager-kafka&lt;br&gt;&lt;span style='font-weight:normal'&gt;3 vCPU / 12 GiB (≈8 MBps produced at RF 3, 50% util)&lt;br&gt;regional: Google spreads brokers over a/b/c&lt;br&gt;RF 3 · min.insync.replicas 2 · &lt;b&gt;no backup / no mirroring&lt;/b&gt;&lt;/span&gt;" vertex="1"><mxGeometry x="1220" y="170" width="425" height="405" as="geometry"/></mxCell>
        <mxCell id="bra" parent="1" style="fillColor=#FFE6CC;strokeColor=#D79B00;rounded=1;fontSize=11;html=1;whiteSpace=wrap;" value="broker(s) · zone a" vertex="1"><mxGeometry x="1235" y="260" width="125" height="45" as="geometry"/></mxCell>
